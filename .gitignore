# 编译输出
/target/
**/*.rs.bk

# 本仓库是可执行（二进制）项目：Cargo.lock 需要提交入库以保证可复现构建，故此处不再忽略

# mcp-client 测试客户端：只入库源码（src/、package.json、tsconfig、pnpm-lock），忽略其余
mcp-client/node_modules/
mcp-client/dist/
mcp-client/*.log
mcp-client/go.mod
mcp-client/go.sum
mcp-client/package-lock.json
mcp-client/test-kill-shell.ps1

# IDE和编辑器文件
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 环境变量
.env
.env.local
.env.*.local

# 日志文件
*.log
logs/

# 测试覆盖率报告
coverage/
*.profraw
*.lcov

# 临时文件
tmp/
temp/
*.tmp

# Rust 相关
Cargo.lock.backup

# 自定义构建输出
build/
dist/
out/

# 调试文件
*.pdb

# 可选：本地开发配置文件
.config/
.local/
